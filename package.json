{
  "name": "totemkit",
  "version": "1.0.0",
  "private": true,
  "description": "Photo-to-video processing application",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm -F frontend dev",
    "dev:backend": "pnpm -F backend dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm -F frontend build",
    "build:backend": "pnpm -F backend build",
    "start:backend": "pnpm -F backend start",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  }
}
